# functions/.env.example
#
# firebase-functions v2 loads .env files from this directory automatically
# (functions/.env for all environments, functions/.env.<project-id> for a
# specific project, functions/.env.local for the emulator — see
# https://firebase.google.com/docs/functions/config-env).
#
# For anything actually sensitive, prefer Firebase-managed secrets over a
# checked-in .env file, even a gitignored one:
#   npx firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   npx firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# Then reference them in the function definition's `secrets: [...]` option.
#
# functions/src/razorpayFunctions.ts reads these via process.env with NO
# hardcoded fallback — a missing value now fails the request loudly instead
# of silently using a shared literal. Do not reintroduce a fallback default.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
