{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(user)/layout,_N_T_/(user)/vendor/layout,_N_T_/(user)/vendor/detail/layout,_N_T_/(user)/vendor/detail/page,_N_T_/vendor/detail"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KHVzZXIp/vendor/detail/__PAGE__",
    "/!KHVzZXIp/vendor/detail",
    "/!KHVzZXIp/vendor",
    "/!KHVzZXIp",
    "/_index",
    "/_head"
  ]
}