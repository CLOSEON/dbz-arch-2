{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vendor/layout,_N_T_/vendor/menu/layout,_N_T_/vendor/menu/page,_N_T_/vendor/menu"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vendor/menu/__PAGE__",
    "/vendor/menu",
    "/vendor",
    "/_index",
    "/_head"
  ]
}