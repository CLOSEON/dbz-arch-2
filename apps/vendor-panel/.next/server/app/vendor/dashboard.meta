{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vendor/layout,_N_T_/vendor/dashboard/layout,_N_T_/vendor/dashboard/page,_N_T_/vendor/dashboard"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vendor/dashboard/__PAGE__",
    "/vendor/dashboard",
    "/vendor",
    "/_index",
    "/_head"
  ]
}