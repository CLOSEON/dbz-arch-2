      "regex": "^/admin/discount\\-codes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/discount\\-codes(?:/)?$"
    },
    {
      "page": "/admin/migrate",
      "regex": "^/admin/migrate(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/migrate(?:/)?$"
    },
    {
      "page": "/admin/notifications",
      "regex": "^/admin/notifications(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/notifications(?:/)?$"
    },
    {
      "page": "/admin/orders",
      "regex": "^/admin/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/orders(?:/)?$"
    },
    {
      "page": "/admin/subscriptions",
      "regex": "^/admin/subscriptions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/subscriptions(?:/)?$"
    },
    {
      "page": "/admin/support",
      "regex": "^/admin/support(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/support(?:/)?$"
    },
    {
      "page": "/admin/swaps",
