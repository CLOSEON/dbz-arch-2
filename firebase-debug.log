[debug] [2026-09-11T19:50:22.447Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/dabzofb/rulesets {"name":"projects/dabzofb/rulesets/c3746cdb-c019-49ac-9660-c683d2a0f773","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // HELPER FUNCTIONS & ROLE ENFORCEMENT\n    // ═══════════════════════════════════════════════════════════════════════\n\n    // Admin Role Enforcement:\n    // WHY CUSTOM CLAIMS (request.auth.token.admin == true) vs FIRESTORE DOCUMENT FIELD:\n    // 1. SECURITY & INTEGRITY: Document fields in Firestore can be accidentally exposed or tampered with\n    //    if a client-side update rule has a flaw. Firebase Auth Custom Claims are cryptographically signed\n    //    JWT tokens issued exclusively by the Firebase Admin SDK / Cloud Functions, preventing any\n    //    client-side privilege escalation attacks.\n    // 2. PERFORMANCE & ZERO COST: Validating request.auth.token.admin == true evaluates instantly in memory\n    //    with 0 additional Firestore document reads (0ms latency, $0 cost). Checking a document field\n    //    requires an expensive get() lookup on every single security rule evaluation.\n    function isAdmin() {\n      return request.auth != null && (\n        request.auth.token.admin == true ||\n        request.auth.token.role == 'admin' ||\n        request.auth.token.role == 'superadmin' ||\n        request.auth.token.email == 'closeon.st@gmail.com' ||\n        (\n          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('admin', false) == true\n          )\n        )\n      );\n    }\n\n    // Verified Vendor Check:\n    // User must be authenticated and have roles.vendor.status == \"verified\" in their users/{uid} document.\n    // Includes fallback to legacy role == \"vendor\" or \"kitchen\" for smooth migration.\n    function isVerifiedVendor() {\n      return request.auth != null && (\n        isAdmin() ||\n        (\n          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('vendor', {}).get('status', '') == \"verified\" ||\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['vendor', 'kitchen']\n          )\n        )\n      );\n    }\n\n    // Verified Rider Check:\n    // User must be authenticated and have roles.rider.status == \"verified\" in their users/{uid} document.\n    // Includes fallback to role in ['delivery', 'delivery_agent', 'rider'] for smooth migration.\n    function isVerifiedRider() {\n      return request.auth != null && (\n        isAdmin() ||\n        (\n          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', {}).get('rider', {}).get('status', '') == \"verified\" ||\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['delivery', 'delivery_agent', 'rider']\n          )\n        )\n      );\n    }\n\n    // Customer Check:\n    // User is an authenticated customer.\n    function isCustomer() {\n      return request.auth != null;\n    }\n\n    // Check if caller is a participant in an order/delivery\n    function isDeliveryOrderParticipant(order) {\n      return request.auth != null && (\n        isAdmin() ||\n        (order != null && (\n          order.get('customerId', '') == request.auth.uid ||\n          order.get('user_id', '') == request.auth.uid ||\n          order.get('vendorId', '') == request.auth.uid ||\n          order.get('vendor_id', '') == request.auth.uid ||\n          order.get('driverId', '') == request.auth.uid ||\n          order.get('agentId', '') == request.auth.uid ||\n          order.get('rider_id', '') == request.auth.uid ||\n          order.get('riderId', '') == request.auth.uid ||\n          order.get('assigned_to', '') == request.auth.uid\n        ))\n      );\n    }\n\n    // Verifies that a non-admin user is not attempting privilege escalation to admin,\n    // cannot self-approve as a vendor/rider, and cannot change an already-assigned role.\n    function isValidUserWrite() {\n      let isSuper = request.auth.token.email == 'closeon.st@gmail.com';\n      let reqRole = request.resource.data.get('role', 'user');\n      let reqApproved = request.resource.data.get('is_approved', false);\n      let notAdminEscalation = \n        reqRole != 'admin' &&\n        request.resource.data.get('roles', {}).get('admin', false) != true &&\n        (!('is_superadmin' in request.resource.data) || request.resource.data.is_superadmin != true) &&\n        (!('is_admin' in request.resource.data) || request.resource.data.is_admin != true) &&\n        (!('admin' in request.resource.data) || request.resource.data.admin != true) &&\n        !('permissions' in request.resource.data);\n\n      let partnerApprovalSafe = \n        !(reqRole in ['vendor', 'delivery', 'kitchen', 'delivery_agent', 'rider']) || \n        reqApproved == false || \n        (resource != null && resource.data.get('is_approved', false) == true);\n\n      let roleChangeSafe = \n        resource == null || \n        resource.data.get('role', null) == null || \n        resource.data.get('role', '') == '' ||\n        resource.data.get('role', '') == reqRole;\n\n      return isSuper || isAdmin() || (notAdminEscalation && partnerApprovalSafe && roleChangeSafe);\n    }\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // USERS IDENTITY & MULTI-ROLE DOCUMENT\n    // ═══════════════════════════════════════════════════════════════════════\n    match /users/{userId} {\n      // Users can read their own profile; admins can read all profiles;\n      // any authenticated user can read vendor or rider profiles (needed for storefront & order tracking)\n      allow get: if (\n        request.auth != null && (\n          request.auth.uid == userId ||\n          isAdmin() ||\n          resource.data.get('role', '') in ['vendor', 'delivery', 'kitchen', 'delivery_agent', 'rider']\n        )\n      ) || (\n        resource.data.get('role', '') in ['vendor', 'kitchen']\n      );\n\n      // Admins can list all users; authenticated users can list approved vendors (for storefront)\n      allow list: if isAdmin() || (\n        resource.data.get('role', '') in ['vendor', 'kitchen']\n      );\n\n      // User can create their own profile without privilege escalation\n      allow create: if request.auth != null &&\n        request.auth.uid == userId &&\n        isValidUserWrite();\n\n      // User can update their own profile without privilege escalation\n      allow update: if request.auth != null && (\n        isAdmin() ||\n        (\n          request.auth.uid == userId &&\n          isValidUserWrite()\n        )\n      );\n\n      allow delete: if isAdmin();\n\n      // User saved delivery addresses\n      match /addresses/{addressId} {\n        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());\n      }\n\n      // User in-app notifications\n      match /notifications/{notifId} {\n        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());\n      }\n    }\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // VENDOR-ONLY COLLECTIONS\n    // ═══════════════════════════════════════════════════════════════════════\n\n    // Daily Menus — readable by all (for storefront & menu discovery), writable only by verified vendors or admins\n    match /daily_menus/{menuId} {\n      allow read: if true;\n      allow write: if isVerifiedVendor() && (\n        request.resource.data.get('vendor_id', '') == request.auth.uid ||\n        request.resource.data.get('vendorId', '') == request.auth.uid ||\n        isAdmin()\n      );\n    }\n\n    // Discount Codes — readable by authenticated users, writable only by verified vendors or admins\n    match /discount_codes/{codeId} {\n      allow read: if request.auth != null;\n      allow write: if isVerifiedVendor() && (\n        request.resource.data.get('vendor_id', '') == request.auth.uid ||\n        request.resource.data.get('vendorId', '') == request.auth.uid ||\n        isAdmin()\n      );\n    }\n\n    // Batches — order grouping managed by verified vendors or admins\n    match /batches/{batchId} {\n      allow list, get: if request.auth != null && (isAdmin() || isVerifiedRider() || isVerifiedVendor());\n      allow create: if (isVerifiedVendor() && (\n        request.resource.data.get('vendor_id', '') == request.auth.uid ||\n        request.resource.data.get('vendorId', '') == request.auth.uid\n      )) || isAdmin();\n      allow update: if isVerifiedVendor() || isVerifiedRider() || isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // RIDER-ONLY COLLECTIONS\n    // ═══════════════════════════════════════════════════════════════════════\n\n    // Driver Profiles — managed by verified riders or admins\n    match /driver_profiles/{driverId} {\n      allow read, write: if request.auth != null && request.auth.uid == driverId;\n      allow read, write: if isAdmin();\n      allow read: if isVerifiedRider();\n      allow get: if request.auth != null;\n    }\n\n    // Rider Trips — active delivery routes for verified riders\n    match /rider_trips/{tripId} {\n      allow get: if request.auth != null;\n      allow list: if isVerifiedRider() || isVerifiedVendor() || isAdmin();\n      allow create: if isVerifiedRider() || isAdmin();\n      allow update: if isVerifiedRider() ||\n        (request.auth.uid in resource.data.get('vendorIds', [])) ||\n        (request.auth.uid in resource.data.get('vendor_ids', [])) ||\n        isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // Rider Payments & Payouts — readable by verified rider or admin\n    match /rider_payments/{paymentId} {\n      allow get: if request.auth != null && (resource == null || resource.data.riderId == request.auth.uid || isAdmin());\n      allow list: if isVerifiedRider() || isAdmin();\n      allow write: if isAdmin();\n    }\n\n    match /agent_payouts/{payoutId} {\n      allow read: if request.auth != null && (resource.data.agentId == request.auth.uid || isAdmin());\n      allow write: if isAdmin();\n    }\n\n    // Discrepancies & Reviews — reported by verified riders\n    match /pickup_discrepancies/{discId} {\n      allow list, get: if isVerifiedRider() || isAdmin();\n      allow create: if isVerifiedRider();\n      allow update, delete: if isAdmin();\n    }\n\n    match /failed_delivery_reviews/{reviewId} {\n      allow list, get: if isVerifiedRider() || isAdmin();\n      allow create: if isVerifiedRider();\n      allow update, delete: if isAdmin();\n    }\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // ADMIN-ONLY & AUDIT COLLECTIONS\n    // ═══════════════════════════════════════════════════════════════════════\n    // Partner Applications (Kitchen & Rider onboarding from gig.dabzzo.in)\n    match /partner_applications/{appId} {\n      allow create: if true; // anyone can submit an onboarding application\n      allow read: if isAdmin() || (request.auth != null && resource.data.get('phone', '') == request.auth.token.get('phone_number', ''));\n      allow update, delete: if isAdmin();\n    }\n\n    // Audit logs — append-only audit trail readable only by custom claim admins\n    match /audit_logs/{logId} {\n      allow read: if isAdmin();\n      allow create: if request.auth != null;\n      allow update, delete: if false;\n    }\n\n    // System Events (Notification bus) — written strictly by Cloud Functions / Admin SDK\n    match /system_events/{eventId} {\n      allow read: if request.auth != null && (resource.data.recipientId == request.auth.uid || isAdmin());\n      allow write: if isAdmin();\n    }\n\n    // Promotional Offers Carousel — public read for customer carousel & admin, authenticated write\n    match /offers/{offerId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n\n    // Public Platform Overview Stats — public read for landing page counters & stats, admin write\n    match /platform_stats/{statId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ═══════════════════════════════════════════════════════════════════════\n    // ORDERS & SUBSCRIPTIONS (Customer + Vendor + Rider Shared)\n    // ═══════════════════════════════════════════════════════════════════════\n\n    match /orders/{orderId} {\n      allow list, get: if request.auth != null && (\n        isAdmin() || isVerifiedRider() || isVerifiedVendor() ||\n        resource.data.get('user_id', '') == request.auth.uid ||\n        resource.data.get('customerId', '') == request.auth.uid ||\n        resource.data.get('vendor_id', '') == request.auth.uid ||\n        resource.data.get('vendorId', '') == request.auth.uid ||\n        resource.data.get('rider_id', '') == request.auth.uid ||\n        resource.data.get('riderId', '') == request.auth.uid ||\n        resource.data.get('driverId', '') == request.auth.uid ||\n        resource.data.get('agentId', '') == request.auth.uid\n      );\n      allow create: if request.auth != null && (\n        request.resource.data.get('user_id', '') == request.auth.uid ||\n        request.resource.data.get('customerId', '') == request.auth.uid ||\n        isAdmin()\n      );\n      allow update: if request.auth != null && (\n        isAdmin() ||\n        (\n          isVerifiedRider() && (\n            resource.data.get('driverId', '') == request.auth.uid ||\n            resource.data.get('agentId', '') == request.auth.uid ||\n            resource.data.get('rider_id', '') == request.auth.uid ||\n            resource.data.get('riderId', '') == request.auth.uid ||\n            resource.data.get('assigned_to', '') == request.auth.uid\n          ) &&\n          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_amount', 'payment_status', 'items', 'customerId', 'user_id', 'vendorId', 'vendor_id', 'otp', 'delivery_otp', 'amount', 'status'])\n        ) ||\n        (\n          isVerifiedVendor() && (resource.data.get('vendor_id', '') == request.auth.uid || resource.data.get('vendorId', '') == request.auth.uid) &&\n          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_amount', 'payment_status', 'items', 'customerId', 'user_id', 'driverId', 'agentId', 'rider_id', 'riderId', 'otp', 'delivery_otp', 'amount'])\n        ) ||\n        (\n          (resource.data.get('user_id', '') == request.auth.uid || resource.data.get('customerId', '') == request.auth.uid) &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryPreference', 'deliveryAddress', 'delivery_address', 'instructions', 'status', 'updatedAt', 'updated_at']) &&\n          (\n            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||\n            (request.resource.data.status in ['skipped', 'cancelled'] && resource.data.status in ['created', 'pending'])\n          )\n        )\n      );\n      allow delete: if isAdmin();\n\n      match /notifications/{notificationId} {\n        allow read, create: if isAdmin() || (\n          exists(/databases/$(database)/documents/orders/$(orderId)) &&\n          isDeliveryOrderParticipant(get(/databases/$(database)/documents/orders/$(orderId)).data)\n        );\n        allow update, delete: if isAdmin();\n      }\n    }\n\n    match /deliveries/{deliveryId} {\n      allow create, delete: if isAdmin();\n      allow get: if isAdmin() ||\n                  (isCustomer() && (resource.data.get('customerId', '') == request.auth.uid || resource.data.get('user_id', '') == request.auth.uid)) ||\n                  (isVerifiedVendor() && (resource.data.get('vendorId', '') == request.auth.uid || resource.data.get('vendor_id', '') == request.auth.uid)) ||\n                  (isVerifiedRider() && (\n                    resource.data.get('agentId', '') == request.auth.uid ||\n                    resource.data.get('driverId', '') == request.auth.uid ||\n                    resource.data.get('rider_id', '') == request.auth.uid ||\n                    resource.data.get('riderId', '') == request.auth.uid\n                  ));\n      allow list: if request.auth != null && (\n        isAdmin() || isVerifiedRider() || isVerifiedVendor() ||\n        resource.data.get('customerId', '') == request.auth.uid ||\n        resource.data.get('user_id', '') == request.auth.uid ||\n        resource.data.get('vendorId', '') == request.auth.uid ||\n        resource.data.get('vendor_id', '') == request.auth.uid ||\n        resource.data.get('rider_id', '') == request.auth.uid ||\n        resource.data.get('riderId', '') == request.auth.uid\n      );\n      allow update: if isAdmin() || (\n        isVerifiedRider() && (\n          resource.data.get('agentId', '') == request.auth.uid ||\n          resource.data.get('driverId', '') == request.auth.uid ||\n          resource.data.get('rider_id', '') == request.auth.uid ||\n          resource.data.get('riderId', '') == request.auth.uid\n        )\n      );\n    }\n\n    match /subscriptions/{subId} {\n      allow get: if request.auth != null && (\n        resource == null ||\n        resource.data.user_id == request.auth.uid ||\n        resource.data.vendor_id == request.auth.uid ||\n        isAdmin()\n      );\n      allow list: if request