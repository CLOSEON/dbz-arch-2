{
  "name": "dabzzo-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "dev:web": "npm run dev --workspace=web-main",
    "dev:admin": "npm run dev --workspace=admin-panel",
    "dev:vendor": "npm run dev --workspace=vendor-panel",
    "dev:rider": "npm run dev --workspace=rider-panel",
    "dev:gig": "npm run dev --workspace=gig",
    "build": "next build",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "node scripts/build-web.mjs",
    "deploy:all": "npm run build:all && npx firebase deploy --only hosting",
    "deploy:web": "node scripts/build-web.mjs && npx firebase deploy --only hosting:web-main",
    "deploy:vendor": "npm run build --workspace=vendor-panel && npx firebase deploy --only hosting:vendor-panel",
    "deploy:rider": "npm run build --workspace=rider-panel && npx firebase deploy --only hosting:rider-panel",
    "deploy:admin": "npm run build --workspace=admin-panel && npx firebase deploy --only hosting:admin-panel",
    "deploy:gig": "npm run build --workspace=gig && npx firebase deploy --only hosting:gig",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor-firebase/crashlytics": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@vis.gl/react-google-maps": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.1.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Dabzzo Food Subscription Marketplace — v2"
}
