# Dabzzo v2 — environment variables (keys only, no real values)
#
# Copy this file to .env.local at the repo root and fill in real values.
# scripts/sync-env.mjs copies .env / .env.local from the repo root into each
# app under apps/* before dev/build (wired via predev/prebuild), because
# Next.js only reads env files from its own working directory — see that
# script's header comment for why this exists.
#
# NEVER put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in a NEXT_PUBLIC_*
# var — that prefix is inlined into the client bundle by Next.js and would
# leak the secret to the browser. Both must stay server-only, consumed by
# functions/ (Cloud Functions), never by any app under apps/*.

# ─── Firebase (public web config — safe to expose client-side) ─────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Google Maps (client-side, restrict by HTTP referrer in Cloud Console) ──
NEXT_PUBLIC_GMAPS_KEY=

# ─── Razorpay — public key ID only; safe client-side ────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Razorpay — SERVER-ONLY, functions/ only, never NEXT_PUBLIC_* ───────────
# Set these via Firebase Functions config/secrets, not a committed file:
#   npx firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   npx firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Vercel CLI artifact ─────────────────────────────────────────────────────
# Auto-generated by `vercel` CLI if it's ever run here. This project deploys
# to Firebase Hosting (see firebase.json), not Vercel — this var is not
# required for the Firebase deploy path and can usually be left unset.
# VERCEL_OIDC_TOKEN=
